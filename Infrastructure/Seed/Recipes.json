  {
    "Name": "Creamy Garlic Chicken Pasta",
    "DifficultyId": 2,
    "Tags": ["Dinner", "High Protein", "Comfort Food"],
    "Allergens": ["Milk", "Gluten"],
    "Ingredients": [
      { "Ingredient": "pasta", "Amount": 200, "Unit": "G" },
      { "Ingredient": "chicken", "Amount": 300, "Unit": "G" },
      { "Ingredient": "salt", "Amount": 1, "Unit": "Ts" },
      { "Ingredient": "pepper", "Amount": 0.5, "Unit": "Ts" },
      { "Ingredient": "olive oil", "Amount": 2, "Unit": "Tbs" },
      { "Ingredient": "garlic", "Amount": 3, "Unit": "Clove" },
      { "Ingredient": "heavy cream", "Amount": 2, "Unit": "Dl" },
      { "Ingredient": "parmesan", "Amount": 50, "Unit": "G" }
    ],
    "Instructions": [
      {
        "StepNumber": 1,
        "Text": "Bring a large pot of salted water to a boil and cook pasta until al dente."
      },
      {
        "StepNumber": 2,
        "Text": "Season chicken breasts with salt and pepper, then pan-sear in olive oil over medium-high heat until golden and cooked through."
      },
      {
        "StepNumber": 3,
        "Text": "Remove chicken from the pan and set aside to rest."
      },
      {
        "StepNumber": 4,
        "Text": "In the same pan, add minced garlic and cook for 30–60 seconds until fragrant."
      },
      {
        "StepNumber": 5,
        "Text": "Pour in heavy cream and simmer gently, stirring to combine."
      },
      {
        "StepNumber": 6,
        "Text": "Stir in grated parmesan cheese until the sauce is smooth and creamy."
      },
      {
        "StepNumber": 7,
        "Text": "Slice the chicken and return it to the sauce."
      },
      {
        "StepNumber": 8,
        "Text": "Add drained pasta and toss until fully coated in the sauce."
      },
      {
        "StepNumber": 9,
        "Text": "Serve immediately with extra parmesan and freshly cracked black pepper."
      }
    ]
  },
